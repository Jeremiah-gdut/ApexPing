<Window x:Class="ApexPing.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ApexPing · 桌面战术标记" Width="980" Height="910" MinWidth="820" MinHeight="640"
 WindowStartupLocation="CenterScreen" Background="#101319">
 <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#101319">
  <Grid Margin="30,24,30,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,23">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel>
     <StackPanel Orientation="Horizontal"><Border Background="#E45555" Width="4" Margin="0,3,12,3" /><TextBlock Text="APEX PING" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}" /><TextBlock Text="DESKTOP" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="12,16,0,0" /></StackPanel>
     <TextBlock Text="让每个桌面，都成为你的战术地图。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="16,6,0,0" />
    </StackPanel>
    <Button x:Name="ToggleButton" Grid.Column="1" Click="Toggle_Click" VerticalAlignment="Center" MinWidth="110" AutomationProperties.Name="启用或暂停桌面标记" />
   </Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#181D26" BorderBrush="#2B3240" BorderThickness="1" CornerRadius="10" Padding="20,18">
     <StackPanel>
      <TextBlock Text="战术轮盘" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
      <TextBlock Text="原生游戏图标 · 点击下方按钮预览" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" />
      <ContentControl x:Name="WheelHost" HorizontalAlignment="Center" Margin="0,6,0,0" />
      <UniformGrid x:Name="PingButtons" Rows="2" Columns="4" Margin="0,6,0,0" />
     </StackPanel>
    </Border>
    <StackPanel Grid.Column="2">
     <Border Background="#181D26" BorderBrush="#2B3240" BorderThickness="1" CornerRadius="10" Padding="22,20" Margin="0,0,0,14">
      <StackPanel>
       <TextBlock Text="交互" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" Foreground="{StaticResource TextBrush}" />
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="155" /></Grid.ColumnDefinitions>
        <TextBlock Text="触发键" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
        <ComboBox x:Name="TriggerBox" Grid.Column="1" SelectionChanged="SettingChanged" Padding="8,5" Foreground="#101319" AutomationProperties.Name="轮盘触发键">
         <ComboBoxItem Content="Alt" Tag="alt" /><ComboBoxItem Content="Ctrl" Tag="ctrl" /><ComboBoxItem Content="Shift" Tag="shift" /><ComboBoxItem Content="鼠标侧键 4" Tag="mouse4" /><ComboBoxItem Content="鼠标侧键 5" Tag="mouse5" />
        </ComboBox>
       </Grid>
       <TextBlock x:Name="GestureHelp" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
       <CheckBox x:Name="FullscreenBox" Content="全屏应用中自动暂停" Checked="SettingChanged" Unchecked="SettingChanged" />
       <TextBlock Text="Ctrl + Alt + P 随时启用 / 暂停" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,0" />
      </StackPanel>
     </Border>
     <Border Background="#181D26" BorderBrush="#2B3240" BorderThickness="1" CornerRadius="10" Padding="22,20" Margin="0,0,0,14">
      <StackPanel>
       <Grid><TextBlock Text="声音" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><TextBlock x:Name="VolumeLabel" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" /></Grid>
       <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="5" ValueChanged="SettingChanged" AutomationProperties.Name="音效音量" />
       <CheckBox x:Name="MuteBox" Content="静音" Checked="SettingChanged" Unchecked="SettingChanged" />
       <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
        <TextBlock Text="角色语音" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
        <ComboBox x:Name="LegendBox" Grid.Column="1" SelectionChanged="SettingChanged" Padding="8,5" Foreground="#101319" AutomationProperties.Name="英文角色语音选择" />
       </Grid>
       <TextBlock Text="英文原声 · 连续标记时不会叠加多句语音" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
      </StackPanel>
     </Border>
     <Border Background="#181D26" BorderBrush="#2B3240" BorderThickness="1" CornerRadius="10" Padding="22,20">
      <StackPanel>
       <TextBlock Text="标记效果" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" Foreground="{StaticResource TextBrush}" />
       <Grid><TextBlock Text="大小" Foreground="{StaticResource TextBrush}" /><TextBlock x:Name="ScaleLabel" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" /></Grid>
       <Slider x:Name="ScaleSlider" Minimum="70" Maximum="150" TickFrequency="10" ValueChanged="SettingChanged" AutomationProperties.Name="标记大小" />
       <Grid Margin="0,14,0,0"><TextBlock Text="显示时间" Foreground="{StaticResource TextBrush}" /><TextBlock x:Name="DurationLabel" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" /></Grid>
       <Slider x:Name="DurationSlider" Minimum="0.6" Maximum="3" TickFrequency="0.2" ValueChanged="SettingChanged" AutomationProperties.Name="标记显示时间" />
      </StackPanel>
     </Border>
    </StackPanel>
   </Grid>
   <Border Grid.Row="2" Background="#181D26" BorderBrush="#2B3240" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,18,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="游戏原生资源" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
      <TextBlock x:Name="AssetStatus" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,7,12,0" TextWrapping="Wrap" />
      <TextBlock x:Name="AssetPath" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,6,12,0" TextTrimming="CharacterEllipsis" MaxWidth="610" HorizontalAlignment="Left" />
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="选择文件夹" Click="Assets_Click" Margin="0,0,8,0" />
      <Button Content="重新载入" Click="Reload_Click" />
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="3" Margin="0,17,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock x:Name="StatusText" Text="正在启动输入组件…" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
     <TextBlock Text="关闭窗口后在托盘运行 · 退出请使用托盘菜单  |  v0.3.0" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
    </StackPanel>
    <Button Grid.Column="1" Content="收起到托盘" Click="Hide_Click" Margin="16,0,0,0" />
   </Grid>
  </Grid>
 </ScrollViewer>
</Window>
