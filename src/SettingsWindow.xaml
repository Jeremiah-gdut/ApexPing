<Window x:Class="ApexPing.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ApexPing" Width="1120" Height="820" MinWidth="940" MinHeight="620"
 WindowStartupLocation="CenterScreen" TextOptions.TextFormattingMode="Display" Style="{StaticResource {x:Type Window}}">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource NavigationBrush}">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="22,28,16,28">
     <Border Width="42" Height="42" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Margin="0,0,12,0">
      <Image x:Name="BrandIcon" Width="25" Height="25" RenderOptions.BitmapScalingMode="HighQuality" />
     </Border>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="ApexPing" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="桌面战术标记" Style="{StaticResource Description}" /></StackPanel>
    </StackPanel>
    <StackPanel Grid.Row="1">
     <RadioButton x:Name="NavWheel" GroupName="Navigation" Tag="wheel" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked" IsChecked="True" AutomationProperties.Name="轮盘与标记">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEB05;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="32" /><TextBlock Text="轮盘与标记" /></StackPanel>
     </RadioButton>
     <RadioButton x:Name="NavSound" GroupName="Navigation" Tag="sound" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked" AutomationProperties.Name="声音与角色">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="32" /><TextBlock Text="声音与角色" /></StackPanel>
     </RadioButton>
     <RadioButton x:Name="NavInput" GroupName="Navigation" Tag="input" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked" AutomationProperties.Name="快捷键与交互">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="32" /><TextBlock Text="快捷键与交互" /></StackPanel>
     </RadioButton>
     <RadioButton x:Name="NavRoom" GroupName="Navigation" Tag="room" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked" AutomationProperties.Name="好友房间">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="32" /><TextBlock Text="好友房间" /></StackPanel>
     </RadioButton>
     <RadioButton x:Name="NavAssets" GroupName="Navigation" Tag="assets" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked" AutomationProperties.Name="资源与应用">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="32" /><TextBlock Text="资源与应用" /></StackPanel>
     </RadioButton>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="24,16,20,24">
     <TextBlock Text="随时切换标记状态" Style="{StaticResource Description}" />
     <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="5" Padding="10,6" HorizontalAlignment="Left" Margin="0,8,0,16">
      <TextBlock Text="Ctrl + Alt + P" FontSize="12" />
     </Border>
     <TextBlock x:Name="AppVersionText" Style="{StaticResource Description}" />
    </StackPanel>
   </Grid>
  </Border>
  <Border Grid.Column="1" Background="{DynamicResource ContentBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1,1,0,0" CornerRadius="10,0,0,0" Margin="0,8,0,0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="30,26,30,24">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" /><TextBlock x:Name="PageDescription" Style="{StaticResource Description}" Margin="0,6,0,0" /></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,5,0,0">
      <Ellipse x:Name="EnabledDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" />
      <TextBlock x:Name="EnabledText" Text="已启用" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" />
      <Button x:Name="ToggleButton" Click="Toggle_Click" AutomationProperties.Name="启用或暂停桌面标记" />
     </StackPanel>
    </Grid>
    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,0,22,24">
     <Grid Margin="0,0,8,0">
      <StackPanel x:Name="WheelPage">
       <Border CornerRadius="10" Padding="16,14,22,18" BorderBrush="#38404A" BorderThickness="1">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#292E38" Offset="0" /><GradientStop Color="#14171D" Offset="1" /></LinearGradientBrush></Border.Background>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
         <Grid x:Name="WheelPreviewTarget" Width="340" Height="340" Background="Transparent" MouseMove="WheelPreview_Move" MouseLeave="WheelPreview_Leave" MouseLeftButtonUp="WheelPreview_Click" Cursor="Hand" AutomationProperties.Name="轮盘交互预览">
          <ContentControl x:Name="WheelHost" Width="340" Height="340" IsHitTestVisible="False" />
         </Grid>
         <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
          <TextBlock Text="轮盘预览" Foreground="#B5BECD" FontSize="12" Margin="0,0,0,16" />
          <TextBlock x:Name="PreviewTitle" Text="前往这里" Foreground="#F5F7FA" FontSize="26" FontWeight="SemiBold" />
          <TextBlock x:Name="PreviewEnglish" Text="GO" Foreground="#FFB400" FontSize="11" Margin="0,6,0,16" />
          <TextBlock Text="移动鼠标选择标记，点击试听。" Foreground="#C1C7D0" FontSize="12" TextWrapping="Wrap" LineHeight="20" />
          <TextBlock Text="预览仅在本机播放，不会发送到好友房间。" Foreground="#9DA7B7" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20" />
         </StackPanel>
        </Grid>
       </Border>
       <UniformGrid x:Name="PingButtons" Rows="2" Columns="4" Margin="-3,10,-3,0" />
       <TextBlock Text="标记外观" Style="{StaticResource SectionTitle}" />
       <Border Style="{StaticResource Card}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center"><TextBlock Text="标记大小" FontSize="14" /><TextBlock Text="调整桌面轮盘与标记的显示比例" Style="{StaticResource Description}" Margin="0,3,12,0" /></StackPanel>
         <StackPanel Grid.Column="1"><TextBlock x:Name="ScaleLabel" HorizontalAlignment="Right" Style="{StaticResource Description}" /><Slider x:Name="ScaleSlider" Minimum="70" Maximum="150" TickFrequency="10" ValueChanged="SettingChanged" AutomationProperties.Name="标记大小" /></StackPanel>
        </Grid>
       </Border>
       <Border Style="{StaticResource Card}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center"><TextBlock Text="显示时间" FontSize="14" /><TextBlock Text="标记会在结束前自然淡出" Style="{StaticResource Description}" Margin="0,3,12,0" /></StackPanel>
         <StackPanel Grid.Column="1"><TextBlock x:Name="DurationLabel" HorizontalAlignment="Right" Style="{StaticResource Description}" /><Slider x:Name="DurationSlider" Minimum="0.6" Maximum="3" TickFrequency="0.2" ValueChanged="SettingChanged" AutomationProperties.Name="标记显示时间" /></StackPanel>
        </Grid>
       </Border>
      </StackPanel>
      <StackPanel x:Name="SoundPage" Visibility="Collapsed">
       <Border Style="{StaticResource Card}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center"><TextBlock Text="音效音量" FontSize="14" /><TextBlock Text="同时控制本机与房间标记的音效和语音" Style="{StaticResource Description}" Margin="0,3,16,0" /></StackPanel>
         <StackPanel Grid.Column="1"><TextBlock x:Name="VolumeLabel" HorizontalAlignment="Right" Style="{StaticResource Description}" /><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="5" ValueChanged="SettingChanged" AutomationProperties.Name="音效音量" /></StackPanel>
        </Grid>
       </Border>
       <Border Style="{StaticResource Card}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="静音" FontSize="14" /><TextBlock Text="关闭所有标记音效与角色语音" Style="{StaticResource Description}" Margin="0,3,12,0" /></StackPanel>
         <CheckBox x:Name="MuteBox" Grid.Column="1" Checked="SettingChanged" Unchecked="SettingChanged" AutomationProperties.Name="静音" />
        </Grid>
       </Border>
       <TextBlock Text="传奇角色" Style="{StaticResource SectionTitle}" />
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="角色语音" FontSize="14" /><TextBlock Text="标记时播放所选角色的英文原声" Style="{StaticResource Description}" Margin="0,3,12,0" /></StackPanel>
          <ComboBox x:Name="LegendBox" Grid.Column="1" SelectionChanged="SettingChanged" AutomationProperties.Name="英文角色语音选择" />
         </Grid>
         <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,14,0,0">
          <TextBlock Text="可回到「轮盘与标记」试听。连续标记时，角色语音不会重叠播放；好友收到的是你选择的角色。" Style="{StaticResource Description}" />
         </Border>
        </StackPanel>
       </Border>
      </StackPanel>
      <StackPanel x:Name="InputPage" Visibility="Collapsed">
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="轮盘触发键" FontSize="14" /><TextBlock Text="选择习惯使用的键盘或鼠标按键" Style="{StaticResource Description}" Margin="0,3,12,0" /></StackPanel>
          <ComboBox x:Name="TriggerBox" Grid.Column="1" SelectionChanged="SettingChanged" AutomationProperties.Name="轮盘触发键">
           <ComboBoxItem Content="Alt" Tag="alt" /><ComboBoxItem Content="Ctrl" Tag="ctrl" /><ComboBoxItem Content="Shift" Tag="shift" /><ComboBoxItem Content="鼠标侧键 4" Tag="mouse4" /><ComboBoxItem Content="鼠标侧键 5" Tag="mouse5" />
          </ComboBox>
         </Grid>
         <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,14,0,0"><TextBlock x:Name="GestureHelp" Style="{StaticResource Description}" /></Border>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="全屏应用中自动暂停" FontSize="14" /><TextBlock Text="离开全屏应用后，自动恢复桌面标记" Style="{StaticResource Description}" Margin="0,3,12,0" /></StackPanel>
         <CheckBox x:Name="FullscreenBox" Grid.Column="1" Checked="SettingChanged" Unchecked="SettingChanged" AutomationProperties.Name="全屏应用中自动暂停" />
        </Grid>
       </Border>
       <TextBlock Text="快捷操作" Style="{StaticResource SectionTitle}" />
       <Border Style="{StaticResource Card}">
        <StackPanel><TextBlock Text="Ctrl + Alt + P" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="启用或暂停标记，也会同步暂停房间中的标记收发。" Style="{StaticResource Description}" Margin="0,8,0,0" /></StackPanel>
       </Border>
      </StackPanel>
      <StackPanel x:Name="RoomPage" Visibility="Collapsed">
       <Border x:Name="RoomCard" Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="连接好友" FontSize="16" FontWeight="SemiBold" />
         <TextBlock Text="最多 8 人共享桌面标记与角色语音。" Style="{StaticResource Description}" Margin="0,6,0,20" />
         <TextBlock Text="你的昵称" Margin="0,0,0,7" />
         <TextBox x:Name="PlayerNameBox" MaxLength="32" LostFocus="SettingChanged" AutomationProperties.Name="房间显示昵称" MaxWidth="300" HorizontalAlignment="Left" Width="300" />
         <TextBlock Text="房间码" Margin="0,20,0,7" />
         <TextBox x:Name="RoomCodeBox" MaxLength="100" FontFamily="Cascadia Code, Consolas" AutomationProperties.Name="APEX 房间码" ToolTip="粘贴朋友分享的 APEX 房间码，或点击创建房间" />
         <WrapPanel Margin="0,12,0,0">
          <Button x:Name="RoomCreateButton" Style="{StaticResource AccentButton}" Content="创建房间" Click="RoomCreate_Click" Margin="0,0,8,6" />
          <Button x:Name="RoomJoinButton" Content="加入房间" Click="RoomJoin_Click" Margin="0,0,8,6" />
          <Button x:Name="RoomCopyButton" Content="复制房间码" Click="RoomCopy_Click" Margin="0,0,8,6" />
          <Button x:Name="RoomLeaveButton" Content="离开" Click="RoomLeave_Click" Margin="0,0,0,6" />
         </WrapPanel>
         <Border Background="{DynamicResource SubtleBrush}" CornerRadius="5" Padding="12" Margin="0,12,0,0"><TextBlock x:Name="RoomStatus" Style="{StaticResource Description}" /></Border>
         <ListBox x:Name="RoomMembers" DisplayMemberPath="Label" MaxHeight="200" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="0,10,0,0" AutomationProperties.Name="房间成员与连接方式" />
        </StackPanel>
       </Border>
       <TextBlock Text="连接与接收" Style="{StaticResource SectionTitle}" />
       <Border Style="{StaticResource Card}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="允许公网联机" FontSize="14" /><TextBlock Text="优先 P2P，直连受限时使用免费公共中继；关闭后仅局域网可用。" Style="{StaticResource Description}" Margin="0,3,20,0" /></StackPanel>
         <CheckBox x:Name="RoomInternetBox" Grid.Column="1" Checked="SettingChanged" Unchecked="SettingChanged" AutomationProperties.Name="允许公网联机" />
        </Grid>
       </Border>
       <Border Style="{StaticResource Card}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="屏蔽房间标记与语音" FontSize="14" /><TextBlock Text="只屏蔽接收，你的标记仍会发送给好友。" Style="{StaticResource Description}" Margin="0,3,20,0" /></StackPanel>
         <CheckBox x:Name="RoomMutedBox" Grid.Column="1" Checked="SettingChanged" Unchecked="SettingChanged" AutomationProperties.Name="屏蔽收到的房间标记与语音" />
        </Grid>
       </Border>
       <TextBlock Text="房间消息端到端加密，请只把房间码分享给朋友。标记按屏幕相对位置同步；不同视角下可能对应不同目标。" Style="{StaticResource Description}" Margin="2,12,0,0" />
      </StackPanel>
      <StackPanel x:Name="AssetsPage" Visibility="Collapsed">
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="游戏原生资源" FontSize="16" FontWeight="SemiBold" />
         <TextBlock x:Name="AssetStatus" Style="{StaticResource Description}" Margin="0,8,0,0" />
         <Border Background="{DynamicResource SubtleBrush}" CornerRadius="5" Padding="12" Margin="0,16,0,16"><TextBlock x:Name="AssetPath" Style="{StaticResource Description}" TextWrapping="Wrap" /></Border>
         <StackPanel Orientation="Horizontal"><Button Content="选择文件夹" Click="Assets_Click" Margin="0,0,8,0" /><Button Content="重新载入" Click="Reload_Click" /></StackPanel>
        </StackPanel>
       </Border>
       <TextBlock Text="后台运行" Style="{StaticResource SectionTitle}" />
       <Border Style="{StaticResource Card}"><TextBlock Text="关闭窗口会收起到系统托盘。点击托盘图标可重新打开设置，右键菜单可以退出 ApexPing。" Style="{StaticResource Description}" /></Border>
      </StackPanel>
     </Grid>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="26,12">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="正在启动输入组件…" Style="{StaticResource Description}" VerticalAlignment="Center" Margin="0,0,14,0" />
      <Button Grid.Column="1" Content="收起到托盘" Click="Hide_Click" />
     </Grid>
    </Border>
   </Grid>
  </Border>
 </Grid>
</Window>
