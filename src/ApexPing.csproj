<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AssemblyName>ApexPing</AssemblyName>
    <Version>0.4.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/app.ico" />
    <Resource Include="Assets/app.png" />
    <Content Include="../native/hook-helper/build/hook-helper.exe" Link="hook-helper.exe" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../native/hook-helper/LICENSE" Link="licenses/lolPing-MIT.txt" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="Network/NBitcoin.Secp256k1.LICENSE" Link="licenses/NBitcoin.Secp256k1-MIT.txt" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../assets/native/**/*" Exclude="../assets/native/.gitkeep" Link="assets/native/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NBitcoin.Secp256k1" Version="4.0.4" />
  </ItemGroup>
</Project>
